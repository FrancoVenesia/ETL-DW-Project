        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DW Load\Truncado y Borrado DW"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CE408CEA-26ED-4D26-A09E-4752D50CA1CA}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Truncado y Borrado DW"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1D266CA7-5049-4F13-9620-B3546099B7A8}"
              SQLTask:SqlStatementSource="-- Hechos y errores no tienen FKs que los referencien: TRUNCATE reinicia el IDENTITY de fVenta&#xA;TRUNCATE TABLE fVenta;&#xA;TRUNCATE TABLE fStock;&#xA;TRUNCATE TABLE err.ERROR_dCliente_dGeografia;&#xA;TRUNCATE TABLE err.ERROR_fVenta;&#xA;DELETE FROM dCliente;&#xA;DELETE FROM dEmpleado;&#xA;DELETE FROM dGeografia;&#xA;DELETE FROM dProducto;&#xA;DELETE FROM dTiempo;&#xA;&#xA;-- Miembros desconocidos (-1) para las ventas cuyo cliente o empleado no existe&#xA;INSERT INTO dGeografia (zipcode, region, state, city) VALUES ('-1', 'Desconocido', 'Desconocido', 'Desconocido');&#xA;INSERT INTO dCliente (id_cliente, zipcode, nombre_completo, fecha_nacimiento, tipo_cliente) VALUES (-1, '-1', 'Desconocido', NULL, 'Desconocido');&#xA;INSERT INTO dEmpleado (id_empleado, nombre_completo, genero, categoria, fecha_ingreso, fecha_nacimiento, nivel_educacion) VALUES (-1, 'Desconocido', 'Desconocido', 'Desconocido', NULL, NULL, 'Desconocido');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DW Load\Cargar ventas con miembros desconocidos"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{75932C5C-0E7A-4483-9F43-1FE2AA2352B6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Cargar ventas con miembros desconocidos"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1D266CA7-5049-4F13-9620-B3546099B7A8}"
              SQLTask:SqlStatementSource="-- Ventas cuyo cliente o empleado no existe en las dimensiones: los lookups del paquete&#xA;-- las registran en err.ERROR_fVenta y aca se cargan con el miembro desconocido (-1)&#xA;INSERT INTO fVenta (version_sistema, id_venta_sistema, fecha, id_cliente, id_empleado, id_producto, zipcode, nro_factura,&#xA;    cantidad, litros_vendidos, precio_unitario, monto_base, porcentaje_descuento, monto_descuento, monto_final)&#xA;SELECT v.version_sistema, v.id_venta_sistema, v.fecha, ISNULL(c.id_cliente, -1), ISNULL(e.id_empleado, -1), v.id_producto,&#xA;    ISNULL(g.zipcode, '-1'), v.nro_factura, v.cantidad, v.litros_vendidos, v.precio_unitario, v.monto_base,&#xA;    v.porcentaje_descuento, v.monto_descuento, v.monto_final&#xA;FROM (&#xA;    SELECT * FROM STAGING_TDC.dbo.TRF_VTA_HistorySales&#xA;    UNION ALL&#xA;    SELECT * FROM STAGING_TDC.dbo.TRF_VTA_MySQL_VentaActual&#xA;) v&#xA;LEFT JOIN dCliente c ON c.id_cliente = v.id_cliente&#xA;LEFT JOIN dEmpleado e ON e.id_empleado = v.id_empleado&#xA;LEFT JOIN dGeografia g ON g.zipcode = v.zipcode&#xA;WHERE c.id_cliente IS NULL OR e.id_empleado IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DW Load\Registrar rechazos"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{03D8B021-FE96-457E-BE72-7E4F0311E601}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Registrar rechazos"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1D266CA7-5049-4F13-9620-B3546099B7A8}"
              SQLTask:SqlStatementSource="INSERT INTO err.ERROR_fVenta (id_venta, version_sistema, fecha, id_cliente, id_empleado, id_producto, nro_factura, cantidad, Error_code, Error_column)&#xA;SELECT id_venta_sistema, version_sistema, fecha, id_cliente, id_empleado, id_producto, nro_factura, cantidad, Error_code, Error_column&#xA;FROM STAGING_TDC.dbo.TRF_VTA_Rechazos;&#xA;&#xA;-- Motivo de las filas que registraron los lookups y conversiones del paquete&#xA;UPDATE e&#xA;SET Error_code = CASE WHEN c.id_cliente IS NULL THEN 'CLIENTE_INEXISTENTE' ELSE 'EMPLEADO_INEXISTENTE' END,&#xA;    Error_column = CASE WHEN c.id_cliente IS NULL THEN 'id_cliente' ELSE 'id_empleado' END&#xA;FROM err.ERROR_fVenta e&#xA;LEFT JOIN dCliente c ON c.id_cliente = TRY_CONVERT(INT, e.id_cliente)&#xA;WHERE e.Error_code IS NULL;&#xA;&#xA;UPDATE err.ERROR_dCliente_dGeografia&#xA;SET Error_code = CASE WHEN Error_code IS NULL THEN 'ZIPCODE_INEXISTENTE' ELSE 'FECHA_NACIMIENTO_INVALIDA' END,&#xA;    Error_column = CASE WHEN Error_code IS NULL THEN 'zipcode' ELSE 'fecha_nacimiento' END&#xA;WHERE Error_code IS NULL OR TRY_CONVERT(INT, Error_code) IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DW Load\Registrar ejecucion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8612C9CB-A230-4DE4-8B01-E4F167BC56F0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Registrar ejecucion"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1D266CA7-5049-4F13-9620-B3546099B7A8}"
              SQLTask:SqlStatementSource="INSERT INTO etl.Ejecucion (filas_fVenta, filas_fVenta_desconocidas, monto_fVenta, filas_fStock, filas_dCliente,&#xA;    errores_fVenta, errores_dCliente)&#xA;SELECT&#xA;    (SELECT COUNT(*) FROM fVenta),&#xA;    (SELECT COUNT(*) FROM fVenta WHERE id_cliente = -1 OR id_empleado = -1),&#xA;    (SELECT SUM(monto_final) FROM fVenta),&#xA;    (SELECT COUNT(*) FROM fStock),&#xA;    (SELECT COUNT(*) FROM dCliente WHERE id_cliente &lt;&gt; -1),&#xA;    (SELECT COUNT(*) FROM err.ERROR_fVenta),&#xA;    (SELECT COUNT(*) FROM err.ERROR_dCliente_dGeografia);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DW Load\Materializar ventas"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AE28B072-15D7-4589-A814-7271B3EB0A16}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Materializar ventas"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CED86DCA-C5D5-49E3-84D7-626901203B20}"
              SQLTask:SqlStatementSource="-- Las vistas de ventas se calculan una sola vez y de a una. Si el data flow de hechos abre las&#xA;-- vistas a la vez, cada una reserva memoria para ordenar y pueden trabarse esperandose entre si.&#xA;DROP TABLE IF EXISTS dbo.TRF_VTA_HistorySales;&#xA;DROP TABLE IF EXISTS dbo.TRF_VTA_MySQL_VentaActual;&#xA;DROP TABLE IF EXISTS dbo.TRF_VTA_Rechazos;&#xA;&#xA;SELECT * INTO dbo.TRF_VTA_HistorySales FROM dbo.VW_VTA_HistorySales;&#xA;SELECT * INTO dbo.TRF_VTA_MySQL_VentaActual FROM dbo.VW_VTA_MySQL_VentaActual;&#xA;SELECT * INTO dbo.TRF_VTA_Rechazos FROM dbo.VW_VTA_Rechazos;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
