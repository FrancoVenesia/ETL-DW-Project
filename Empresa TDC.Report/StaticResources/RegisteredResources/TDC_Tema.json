              "solid": {
                "color": "#f6f8fb"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#184f95"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#f6f8fb"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#e4e7ec"
              }
            },
            "gridVertical": false,
            "rowPadding": 4
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
