  "background": "#ffffff",
  "backgroundLight": "#f6f8fb",
  "backgroundNeutral": "#e4e7ec",
  "tableAccent": "#2a78d6",
  "accent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
