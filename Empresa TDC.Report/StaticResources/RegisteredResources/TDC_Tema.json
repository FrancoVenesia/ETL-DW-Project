            "position": "Outer",
            "color": {
              "solid": {
                "color": "#1f2937"
              }
            },
            "transparency": 92,
            "shadowBlur": 12,
            "shadowDistance": 2,
            "shadowSpread": 0,
            "angle": 90
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
