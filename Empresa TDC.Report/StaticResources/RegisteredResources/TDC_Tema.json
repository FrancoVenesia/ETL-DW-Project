                "color": "#898781"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#e1e0d9"
              }
            },
            "gridlineStyle": "solid",
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
