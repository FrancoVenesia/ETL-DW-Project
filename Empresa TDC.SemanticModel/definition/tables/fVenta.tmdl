table fVenta
	lineageTag: 93b901ca-1231-4651-b65a-e0ea97e6ab63

	measure 'Monto total vendido' = SUM(fVenta[monto_final])
		lineageTag: 6bcf11a0-7ecf-40f4-a1ab-68ddd024e74b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Litros vendidos' = ```
			SUM(fVenta[litros_vendidos])
			
			```
		lineageTag: 2fb24656-a201-4d81-b481-42dfe93923f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad de clientes' = ```
			DISTINCTCOUNT(fVenta[id_cliente])
			
			```
		formatString: 0
		lineageTag: 3f2477d8-0231-4b10-999b-5bfc1a42cd3c

	measure 'Productos vendidos' = ```
			SUM(fVenta[cantidad])
			
			```
		formatString: 0
		lineageTag: f9e75e59-62c8-420e-8cca-fec372494eca

	measure 'Litros promedio por cliente' =
			
			DIVIDE(
			    [Litros vendidos],
			    [Cantidad de clientes]
			)
		lineageTag: a691968c-5701-4a3f-a2dd-b41f3eaaf039

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monto acumulado vendido' =
			
			CALCULATE(
			    [Monto total vendido],
			    FILTER(
			        ALLSELECTED(dTiempo[fecha]),
			        dTiempo[fecha] <= MAX(dTiempo[fecha])
			    )
			)
		lineageTag: 7252b88f-fa92-4a0f-8c3c-da3adb978d0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad de vendedores' = DISTINCTCOUNT(fVenta[id_empleado])
		formatString: 0
		lineageTag: a0522bdf-911e-4299-a9c2-c42bd71a72c8

	measure 'Acumulado Pareto' =
			
			VAR TotalActual = [Monto total vendido]
			RETURN
			CALCULATE(
			    [Monto total vendido],
			    FILTER(
			        ALLSELECTED(dCliente[nombre_completo]),
			        [Monto total vendido] >= TotalActual
			    )
			)
		lineageTag: e037f0cb-5308-4662-bfde-b4fd83c648d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Porcentaje Pareto' =
			
			DIVIDE(
			    [Acumulado Pareto],
			    CALCULATE(
			        [Monto total vendido],
			        ALLSELECTED(dCliente[nombre_completo])
			    )
			)
		lineageTag: 59b7d7a7-2d38-4fa4-9723-e810633c1f6a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

