	column Edad_Transaccion_Cliente = ```
			
			VAR _FechaNacimiento = RELATED(dCliente[fecha_nacimiento])
			VAR _FechaTransaccion = fVenta[fecha]
			RETURN
			    IF(
			        NOT ISBLANK(_FechaNacimiento) && NOT ISBLANK(_FechaTransaccion),
			        YEAR(_FechaTransaccion) - YEAR(_FechaNacimiento) 
			            - IF(MONTH(_FechaTransaccion) < MONTH(_FechaNacimiento) || (MONTH(_FechaTransaccion) = MONTH(_FechaNacimiento) && DAY(_FechaTransaccion) < DAY(_FechaNacimiento)), 1, 0),
			        BLANK()
			    )
			```
		formatString: 0
		lineageTag: 674c6940-6c2d-484b-ab27-31abb45085f7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Rango_Etario = ```
			
			IF(
			    ISBLANK(fVenta[Edad_Transaccion_Cliente]), 
			    "Otro",
			    IF(
			        fVenta[Edad_Transaccion_Cliente] >= 13 && fVenta[Edad_Transaccion_Cliente] <= 19, 
			        "13-19: Adolescentes",
			        IF(
			            fVenta[Edad_Transaccion_Cliente] >= 40 && fVenta[Edad_Transaccion_Cliente] <= 50, 
			            "40-50: Adultos Medios",
			            IF(
			                fVenta[Edad_Transaccion_Cliente] = 66, 
			                "66: Edad Gerente", 
			                "Otro"
			            )
			        )
			    )
			)
			```
		lineageTag: 596a7363-9e13-4348-8a36-92fdfacd252a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Edad_Transaccion_Empleado = ```
			
			VAR _FechaNacimiento = RELATED(dEmpleado[fecha_nacimiento])
			VAR _FechaTransaccion = fVenta[fecha]
			RETURN
			    IF(
			        NOT ISBLANK(_FechaNacimiento) && NOT ISBLANK(_FechaTransaccion),
			        YEAR(_FechaTransaccion) - YEAR(_FechaNacimiento) 
			            - IF(MONTH(_FechaTransaccion) < MONTH(_FechaNacimiento) || (MONTH(_FechaTransaccion) = MONTH(_FechaNacimiento) && DAY(_FechaTransaccion) < DAY(_FechaNacimiento)), 1, 0),
			        BLANK()
			    )
			```
		formatString: 0
		lineageTag: c8c1c65f-0bc0-4367-b51b-e253de8a109e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Rango_Edad =
			VAR e = fVenta[Edad_Transaccion_Cliente]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(e), "Sin dato",
			        e < 20, "Menos de 20",
			        e < 30, "20 a 29",
			        e < 40, "30 a 39",
			        e < 50, "40 a 49",
			        e < 60, "50 a 59",
			        e < 70, "60 a 69",
			        "70 o más"
			    )
		summarizeBy: none
		sortByColumn: Rango_Edad_Orden
		lineageTag: 62ca7c78-577b-491a-9c62-f77db9112947

		annotation SummarizationSetBy = Automatic

	column Rango_Edad_Orden =
			VAR e = fVenta[Edad_Transaccion_Cliente]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(e), 99,
			        e < 20, 1,
			        e < 30, 2,
			        e < 40, 3,
			        e < 50, 4,
			        e < 60, 5,
			        e < 70, 6,
			        7
			    )
		isHidden
		formatString: 0
		summarizeBy: none
		lineageTag: 1054f0dd-b83b-49ca-8129-d9b586405ff9

		annotation SummarizationSetBy = Automatic

	partition fVenta = m
		mode: import
		source =
				let
				    Origen = Sql.Databases(".\SQLEXPRESS"),
				    DW_TDC = Origen{[Name="DW_TDC"]}[Data],
				    dbo_fVenta = DW_TDC{[Schema="dbo",Item="fVenta"]}[Data]
				in
				    dbo_fVenta

	annotation PBI_ResultType = Table

