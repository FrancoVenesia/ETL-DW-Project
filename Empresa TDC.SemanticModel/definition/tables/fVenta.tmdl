table fVenta
	lineageTag: 93b901ca-1231-4651-b65a-e0ea97e6ab63

	measure 'Monto total vendido' = SUM(fVenta[monto_final])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Ventas
		lineageTag: 6bcf11a0-7ecf-40f4-a1ab-68ddd024e74b

	measure 'Litros vendidos' = SUM(fVenta[litros_vendidos])
		formatString: #,0.00
		displayFolder: Ventas
		lineageTag: 2fb24656-a201-4d81-b481-42dfe93923f5

	measure 'Productos vendidos' = SUM(fVenta[cantidad])
		formatString: #,0
		displayFolder: Ventas
		lineageTag: f9e75e59-62c8-420e-8cca-fec372494eca

	measure 'Monto acumulado vendido' =
			CALCULATE(
			    [Monto total vendido],
			    FILTER(
			        ALLSELECTED(dTiempo[fecha]),
			        dTiempo[fecha] <= MAX(dTiempo[fecha])
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Ventas
		lineageTag: 7252b88f-fa92-4a0f-8c3c-da3adb978d0d

	measure 'Monto año anterior' = CALCULATE([Monto total vendido], SAMEPERIODLASTYEAR(dTiempo[fecha]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Ventas
		lineageTag: 67c1a5e0-b403-44aa-94c0-98ef9cd789d1

	measure 'Variación interanual %' = DIVIDE([Monto total vendido] - [Monto año anterior], [Monto año anterior])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ventas
		lineageTag: fa1c8e8e-0c1f-434c-b38c-6e7492e93427

	measure 'Monto promedio mensual' =
			-- Promedio de los años con ventas en el mes del contexto (para comparar meses)
			AVERAGEX(VALUES(dTiempo[anio]), [Monto total vendido])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Ventas
		lineageTag: 863d481e-b14d-48f5-a91f-61cfd30fa9b8

	measure 'Índice estacional' =
			-- 1 = mes promedio; mayor que 1 = mes por encima del promedio del año
			DIVIDE(
			    [Monto promedio mensual],
			    CALCULATE(
			        AVERAGEX(VALUES(dTiempo[mes]), [Monto promedio mensual]),
			        REMOVEFILTERS(dTiempo[nombre_mes], dTiempo[mes])
			    )
			)
		formatString: 0.00
		displayFolder: Ventas
		lineageTag: e99ebd9a-1134-4597-bc4a-f22637173fde

	measure 'Cantidad de clientes' =
			-- Sin el cliente desconocido (-1)
			CALCULATE(DISTINCTCOUNT(fVenta[id_cliente]), fVenta[id_cliente] <> -1)
		formatString: #,0
		displayFolder: Clientes
		lineageTag: 3f2477d8-0231-4b10-999b-5bfc1a42cd3c

	measure 'Litros promedio por cliente' =
			DIVIDE(
			    [Litros vendidos],
			    [Cantidad de clientes]
			)
		formatString: #,0.00
		displayFolder: Clientes
		lineageTag: a691968c-5701-4a3f-a2dd-b41f3eaaf039

	measure 'Acumulado Pareto' =
			VAR TotalActual = [Monto total vendido]
			RETURN
			CALCULATE(
			    [Monto total vendido],
			    FILTER(
			        ALLSELECTED(dCliente[nombre_completo]),
			        [Monto total vendido] >= TotalActual
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Clientes
		lineageTag: e037f0cb-5308-4662-bfde-b4fd83c648d7

	measure 'Porcentaje Pareto' =
			DIVIDE(
			    [Acumulado Pareto],
			    CALCULATE(
			        [Monto total vendido],
			        ALLSELECTED(dCliente[nombre_completo])
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Clientes
		lineageTag: 59b7d7a7-2d38-4fa4-9723-e810633c1f6a

	measure 'Cantidad de vendedores' =
			-- Sin el empleado desconocido (-1)
			CALCULATE(DISTINCTCOUNT(fVenta[id_empleado]), fVenta[id_empleado] <> -1)
		formatString: #,0
		displayFolder: Empleados
		lineageTag: a0522bdf-911e-4299-a9c2-c42bd71a72c8

	measure '% litros diet' = DIVIDE(CALCULATE([Litros vendidos], dProducto[es_diet] = TRUE()), [Litros vendidos])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Productos
		lineageTag: 746f26d3-2d86-4206-ae08-40499a5842c6

	measure '% litros en lata' = DIVIDE(CALCULATE([Litros vendidos], dProducto[tipo_envase] = "CAN"), [Litros vendidos])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Productos
		lineageTag: 07d9c655-b10c-4660-8118-7865788043ea

	measure 'Participación en monto %' = DIVIDE([Monto total vendido], CALCULATE([Monto total vendido], ALLSELECTED(dProducto)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Productos
		lineageTag: 1d8d4208-051b-4955-89e0-b2a39c7dd854

	measure 'Variación último año completo %' =
			-- Último año con los 12 meses cargados contra el anterior
			VAR UltimoAnio = YEAR(CALCULATE(MAX(fVenta[fecha]), REMOVEFILTERS())) - 1
			VAR Actual = CALCULATE([Monto total vendido], REMOVEFILTERS(dTiempo), dTiempo[anio] = UltimoAnio)
			VAR Anterior = CALCULATE([Monto total vendido], REMOVEFILTERS(dTiempo), dTiempo[anio] = UltimoAnio - 1)
			RETURN DIVIDE(Actual - Anterior, Anterior)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Productos
		lineageTag: 18c81782-116c-4aa1-9c6c-4410f350737c

	measure 'Ranking producto (litros)' =
			IF(
			    ISINSCOPE(dProducto[producto]),
			    RANKX(ALLSELECTED(dProducto[producto]), [Litros vendidos], , DESC, DENSE)
			)
		formatString: 0
		displayFolder: Productos
		lineageTag: 566d1c5b-de7b-4035-92a8-f2f94798b1f3

	measure 'Tendencia mensual' =
			-- Recta de regresion sobre las ventas mensuales, hasta marzo de 2011
			VAR Meses =
			    CALCULATETABLE(
			        FILTER(
			            ADDCOLUMNS(
			                SUMMARIZE(fVenta, dTiempo[anio], dTiempo[mes]),
			                "@t", dTiempo[anio] * 12 + dTiempo[mes],
			                "@monto", [Monto total vendido]
			            ),
			            NOT ISBLANK([@monto])
			        ),
			        REMOVEFILTERS(dTiempo)
			    )
			VAR Recta = LINESTX(Meses, [@monto], [@t])
			VAR t = MAX(dTiempo[anio]) * 12 + MAX(dTiempo[mes])
			VAR Primero = MINX(Meses, [@t])
			RETURN
			    IF(
			        COUNTROWS(Meses) >= 2 && t >= Primero && t <= 2011 * 12 + 3,
			        MAXX(Recta, [Intercept]) + MAXX(Recta, [Slope1]) * t
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Proyecciones
		lineageTag: 5cac0ce6-db74-4fac-8fd1-d9cfef3f8445

	measure 'Proyección 1er trimestre 2011' =
			-- Suma de la recta de regresion de enero a marzo de 2011 (no considera estacionalidad)
			VAR Meses =
			    CALCULATETABLE(
			        FILTER(
			            ADDCOLUMNS(
			                SUMMARIZE(fVenta, dTiempo[anio], dTiempo[mes]),
			                "@t", dTiempo[anio] * 12 + dTiempo[mes],
			                "@monto", [Monto total vendido]
			            ),
			            NOT ISBLANK([@monto])
			        ),
			        REMOVEFILTERS(dTiempo)
			    )
			VAR Recta = LINESTX(Meses, [@monto], [@t])
			RETURN
			    IF(
			        COUNTROWS(Meses) >= 2,
			        SUMX(GENERATESERIES(2011 * 12 + 1, 2011 * 12 + 3, 1), MAXX(Recta, [Intercept]) + MAXX(Recta, [Slope1]) * [Value])
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Proyecciones
		lineageTag: 9389984c-00c7-4403-a2ad-b20dd26b3b8a

	measure 'Proyección 2011' =
			-- Suma de la recta de regresion de los 12 meses de 2011 (en el contexto: por vendedor, etc.)
			VAR Meses =
			    CALCULATETABLE(
			        FILTER(
			            ADDCOLUMNS(
			                SUMMARIZE(fVenta, dTiempo[anio], dTiempo[mes]),
			                "@t", dTiempo[anio] * 12 + dTiempo[mes],
			                "@monto", [Monto total vendido]
			            ),
			            NOT ISBLANK([@monto])
			        ),
			        REMOVEFILTERS(dTiempo)
			    )
			VAR Recta = LINESTX(Meses, [@monto], [@t])
			RETURN
			    IF(
			        COUNTROWS(Meses) >= 2,
			        SUMX(GENERATESERIES(2011 * 12 + 1, 2011 * 12 + 12, 1), MAXX(Recta, [Intercept]) + MAXX(Recta, [Slope1]) * [Value])
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Proyecciones
		lineageTag: 35c01e98-dbaf-43c7-86c2-2e821b56c4e1

