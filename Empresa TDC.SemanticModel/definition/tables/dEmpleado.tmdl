	column antiguedad_anios =
			VAR Fin = MAX(fVenta[fecha])
			RETURN IF(ISBLANK(dEmpleado[fecha_ingreso]), BLANK(), DATEDIFF(dEmpleado[fecha_ingreso], Fin, DAY) / 365.25)
		formatString: 0.0
		lineageTag: 37a3b551-425c-47a4-bfd9-d4070ffde466
		summarizeBy: average

		annotation SummarizationSetBy = User

	partition dEmpleado = m
		mode: import
		source =
				let
				    Origen = Sql.Databases(".\SQLEXPRESS"),
				    DW_TDC = Origen{[Name="DW_TDC"]}[Data],
				    dbo_dEmpleado = DW_TDC{[Schema="dbo",Item="dEmpleado"]}[Data]
				in
