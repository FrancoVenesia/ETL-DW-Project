model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dCliente","dEmpleado","dGeografia","dProducto","dTiempo","fVenta","fStock"]

annotation PBI_ProTooling = ["DevMode"]

ref table dCliente
ref table dEmpleado
ref table dGeografia
ref table dProducto
ref table dTiempo
ref table fVenta
ref table fStock

ref cultureInfo es-AR

